# Copy to .env and fill in. Never commit .env.
# An empty value means the default (src/freight_agent/settings.py). The environment wins
# over this file.

# LLM access (OpenRouter): the model calls of every role, on the platform and in the evals.
# It spends money. Without it the platform starts, but its runs cannot think (each one
# escalates to a Hero) and `agent eval run` refuses to start.
OPENROUTER_API_KEY=

# Observability (optional). Leave empty to disable tracing. The evals need the key: they
# run as LangSmith experiments.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=freight-agent

# Storage of each load's memory (event log, obligations ledger, timers, outbox, run
# records, the event queue, documents) and of the facility notes learned across loads.
# memory (default): gone when the process stops. postgres: on DATABASE_URL, kept across
# restarts; create the tables once with `uv run agent db migrate`. `docker compose up` runs the app on postgres by itself (its
# own database URL wins over this one). The evals and Studio always play in a fresh
# in-memory world. The compose database, published on localhost, is
# postgresql://agent:agent@localhost:5432/agent
PERSISTENCE=
DATABASE_URL=

# Paths, relative to the working directory. Defaults: config/models.yaml, sops, evals,
# web/dist (the built UI; the API serves it when it exists), blobs (attachment bytes,
# created on the first upload).
MODELS_CONFIG=
SOPS_DIR=
EVALS_DIR=
WEB_DIST=
BLOBS_DIR=

# Prompts. The templates come from the LangSmith Prompt Hub at the references of
# PROMPTS_CONFIG (default config/prompts.yaml), resolved once when the process starts;
# without LANGSMITH_API_KEY, or with PROMPTS_SOURCE=local, they are the repository copy
# in PROMPTS_DIR (default prompts). PROMPTS_TAG runs every role at that Hub tag instead
# of its pin (a candidate, in an experiment).
PROMPTS_CONFIG=
PROMPTS_DIR=
PROMPTS_SOURCE=
PROMPTS_TAG=

# The gate (triage of an inbound message). jev (default): the decision model of the
# `decisions` block of config/models.yaml answers with probabilities and code decides; a
# quiet intent (an acknowledgement) ends the run only when P(act now) is under
# GATE_ACT_THRESHOLD (default 0.2). llm: the gate's chat model writes its decision.
GATE_ENGINE=
GATE_ACT_THRESHOLD=

# The facility memory's embeddings: auto (default; the embeddings.memory model of
# config/models.yaml when OPENROUTER_API_KEY is set, else an offline hash) or fake (the
# offline hash always: no network, deterministic). On PERSISTENCE=postgres the vectors
# are as wide as the embeddings.memory model's (1536), whichever is used.
MEMORY_EMBEDDINGS=

# Durable mode (`agent temporal ...`); use a separate Postgres DB from the simulation.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=freight-loads
TEMPORAL_RECONCILE_SECONDS=10
