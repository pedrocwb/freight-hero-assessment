# Copy to .env and fill in. Never commit .env.
# An empty value means the default (src/freight_agent/settings.py). The environment wins
# over this file.

# LLM access (OpenRouter): the model calls of every role, on the platform and in the evals.
# It spends money. Without it the platform starts, but its runs cannot think (each one
# escalates to a Hero) and `agent eval run` refuses to start.
OPENROUTER_API_KEY=

# Observability (optional). Leave empty to disable tracing. The evals need the key: they
# run as LangSmith experiments.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=freight-agent

# Paths, relative to the working directory. Defaults: config/models.yaml, sops, evals,
# web/dist (the built UI; the API serves it when it exists), blobs (attachment bytes,
# created on the first upload).
MODELS_CONFIG=
SOPS_DIR=
EVALS_DIR=
WEB_DIST=
BLOBS_DIR=

# Prompts. The templates come from the LangSmith Prompt Hub at the references of
# PROMPTS_CONFIG (default config/prompts.yaml), resolved once when the process starts;
# without LANGSMITH_API_KEY, or with PROMPTS_SOURCE=local, they are the repository copy
# in PROMPTS_DIR (default prompts). PROMPTS_TAG runs every role at that Hub tag instead
# of its pin (a candidate, in an experiment).
PROMPTS_CONFIG=
PROMPTS_DIR=
PROMPTS_SOURCE=
PROMPTS_TAG=

# The gate (triage of an inbound message). llm (default): the gate's chat model of
# config/models.yaml writes its decision. jev: the decision model of the `decisions` block
# answers with probabilities and code decides; a quiet intent (an acknowledgement) ends
# the run only when P(act now) is under GATE_ACT_THRESHOLD (default 0.2).
GATE_ENGINE=
GATE_ACT_THRESHOLD=
