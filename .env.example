# Copy to .env and fill in. Never commit .env.

# LLM access (OpenRouter)
OPENROUTER_API_KEY=


# Postgres. Local Docker or a Neon connection string.
# Use the pooled host for the API and the direct host for the worker.
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent
DATABASE_URL_DIRECT=

# Observability (optional). Leave empty to disable tracing.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=freight-agent

# Telegram SMS simulation (optional)
TELEGRAM_BOT_TOKEN=
