# Copy to .env and fill in. Never commit .env.
# An empty value means the default (src/freight_agent/settings.py). The environment wins
# over this file.

# LLM access (OpenRouter). Needed by LLM_MODE=live and LLM_MODE=record only: the model
# calls of every role, and the embeddings of a published SOP version. It spends money.
OPENROUTER_API_KEY=

# How the agent gets model answers: scripted | replay | live | record. Default: replay
# (recorded cassettes, offline, no key). Offline modes embed with a deterministic fake.
LLM_MODE=

# Where the agent keeps its state: memory | postgres. Default: memory. With postgres the
# runs also read the brokers and the published SOP versions there (`agent sop import`).
PERSISTENCE=

# Postgres. Local Docker or a Neon connection string.
# Use the pooled host for the API and the direct host for the worker.
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent
DATABASE_URL_DIRECT=

# Observability (optional). Leave empty to disable tracing.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=freight-agent

# Telegram SMS simulation (optional)
TELEGRAM_BOT_TOKEN=

# Paths, relative to the working directory. Defaults: config/models.yaml, sops, evals,
# evals/cassettes, web/dist (the built UI; the API serves it when it exists), blobs
# (attachment and SOP file bytes, created on the first upload).
MODELS_CONFIG=
SOPS_DIR=
EVALS_DIR=
CASSETTES_DIR=
WEB_DIST=
BLOBS_DIR=
